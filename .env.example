# Opcional: sin este archivo, docker compose usa valores por defecto de desarrollo.
# Archivo .env de ejemplo. 
POSTGRES_USER=guardian
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=guardian

# Rate limit de POST /register (ventana fija)
RATE_LIMIT_IP_MAX=40
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=600

# Timeout de conexión y de lectura con Redis, en milisegundos
REDIS_TIMEOUT_MS=200
