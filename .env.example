# Opcional: sin este archivo, docker compose usa valores por defecto de desarrollo.
# Archivo .env de ejemplo. 
POSTGRES_USER=guardian
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=guardian

# Rate limit de POST /register (ventana fija)
RATE_LIMIT_IP_MAX=40
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=600

# Timeout de conexión y de lectura con Redis, en milisegundos
REDIS_TIMEOUT_MS=200

# Timeout de cada consulta DNS (MX y A) en POST /register, en milisegundos
MX_DNS_TIMEOUT_MS=1000

# SOLO PRUEBAS: con "true", el header X-Debug-Client-IP reemplaza la IP del cliente
# para las señales de ASN y país, y /register devuelve "debug_signals". Nunca en producción.
DEBUG_CLIENT_IP_HEADER=

# Clave del HMAC-SHA256 con el que se guarda el correo en audit_log (nunca en claro).
# Vacía = clave de desarrollo con warning al arrancar. En producción, un valor largo y secreto.
AUDIT_HMAC_KEY=
